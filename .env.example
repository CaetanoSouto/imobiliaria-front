# URL base da API. Em desenvolvimento use /api (proxy do Vite para http://localhost:8080).
# Se o backend tiver CORS liberado, pode apontar direto: VITE_API_URL=http://localhost:8080
VITE_API_URL=/api

# E-mail da imobiliária que recebe o contato "Tenho interesse" (botão "Entrar em contato" do detalhe).
VITE_IMOBILIARIA_EMAIL=contato@imobiliaria.com
