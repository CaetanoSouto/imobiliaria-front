# Modelo das credenciais de e-mail do backend (Gmail).
#
# 1. Copie este arquivo para "mail.env.local" (o git ignora esse nome).
# 2. Preencha MAIL_USER e MAIL_PASSWORD.
# 3. Suba o backend com:  .\rodar.ps1
#
# NUNCA escreva a senha neste arquivo de exemplo: ele vai para o GitHub.

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# O seu endereco do Gmail
MAIL_USER=

# Senha de app do Google: 16 letras, sem espacos. NAO e a senha da conta.
# Para gerar: ative a verificacao em duas etapas e abra myaccount.google.com > Senhas de app.
MAIL_PASSWORD=

# Opcional: se ficar vazio, usa o mesmo valor de MAIL_USER
MAIL_FROM=

# Opcional: endereco do front-end, usado no botao dos e-mails (padrao: http://localhost:5173)
SITE_URL=
