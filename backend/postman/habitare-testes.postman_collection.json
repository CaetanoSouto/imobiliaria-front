    {
      "name": "03 - Validar estrutura do JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var token = pm.collectionVariables.get('tokenAdmin') || '';",
              "var parts = token.split('.');",
              "pm.test('03 - Token tem exatamente 3 partes (header.payload.signature)', function () {",
              "    pm.expect(parts.length).to.eql(3);",
              "});",
              "pm.test('03 - Payload decodificado contem sub, roles e exp', function () {",
              "    pm.expect(parts.length).to.be.gte(2);",
              "    var b64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');",
              "    while (b64.length % 4) { b64 += '='; }",
              "    var payload = JSON.parse(atob(b64));",
              "    pm.expect(payload).to.have.property('sub');",
              "    pm.expect(payload).to.have.property('roles');",
              "    pm.expect(payload).to.have.property('exp');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{tokenAdmin}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/imoveis",
          "host": ["{{baseUrl}}"],
          "path": ["imoveis"]
        }
      },
      "response": []
    },
