    {
      "name": "05 - POST /bairros com tokenAdmin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('05 - Status 201: bairro criado com sucesso', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "if (json && json.id) {",
              "    pm.collectionVariables.set('bairroId', json.id);",
              "    console.log('bairroId salvo: ' + json.id);",
              "} else {",
              "    pm.sendRequest({",
              "        url: pm.collectionVariables.get('baseUrl') + '/bairros',",
              "        method: 'GET',",
              "        header: [{ key: 'Authorization', value: 'Bearer ' + pm.collectionVariables.get('tokenAdmin') }]",
              "    }, function (err, res) {",
              "        if (!err) {",
              "            var list = res.json();",
              "            var found = Array.isArray(list) ? list.find(function (b) {",
              "                return b.nome === 'Bairro Teste Automatizado';",
              "            }) : null;",
              "            if (found) {",
              "                pm.collectionVariables.set('bairroId', found.id);",
              "                console.log('bairroId salvo via GET fallback: ' + found.id);",
              "            }",
              "        }",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{tokenAdmin}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Bairro Teste Automatizado\"\n}",
