    {
      "name": "09 - POST /bairros com token adulterado",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Pega o tokenAdmin, troca o payload (parte do meio) por um falso,",
              "// mantém o header e a assinatura originais => JWT invalido para o servidor.",
              "var token = pm.collectionVariables.get('tokenAdmin') || '';",
              "var parts = token.split('.');",
              "if (parts.length === 3) {",
              "    var fake = { sub: 'hacker@evil.com', roles: ['ADMIN'], exp: 9999999999 };",
              "    var fakeB64 = btoa(JSON.stringify(fake))",
              "        .split('+').join('-')",
              "        .split('/').join('_')",
              "        .split('=').join('');",
              "    pm.collectionVariables.set('tokenAdulterated', parts[0] + '.' + fakeB64 + '.' + parts[2]);",
              "    console.log('Token adulterado gerado (payload trocado, assinatura original mantida).');",
              "} else {",
              "    pm.collectionVariables.set('tokenAdulterated', 'x.invalido.y');",
              "    console.warn('tokenAdmin indisponivel; usando token invalido generico.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('09 - Status 401: token adulterado rejeitado pelo servidor', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{tokenAdulterated}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Bairro Hacker\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/bairros",
          "host": ["{{baseUrl}}"],
          "path": ["bairros"]
        }
      },
      "response": []
    },
    {
      "name": "99 - Limpeza",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Apaga o usuario cliente criado no passo 06.",
              "// AJUSTE o endpoint se a sua API usar caminho diferente (ex.: /admin/users/:id).",
              "var cId  = pm.collectionVariables.get('clienteId');",
              "var base = pm.collectionVariables.get('baseUrl');",
              "var tok  = pm.collectionVariables.get('tokenAdmin');",
              "if (cId && base && tok) {",
              "    pm.sendRequest({",
              "        url: base + '/users/' + cId,",
              "        method: 'DELETE',",
              "        header: [{ key: 'Authorization', value: 'Bearer ' + tok }]",
              "    }, function (err, res) {",
              "        if (err) {",
              "            console.warn('Erro ao deletar usuario: ' + err);",
              "        } else {",
              "            console.log('Usuario deletado. HTTP ' + res.status);",
              "        }",
              "    });",
              "} else {",
              "    console.warn('clienteId ou tokenAdmin nao definidos. Pulando exclusao do usuario.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('99 - Bairro de teste removido com sucesso (200 ou 204)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});",
              "// Limpar todas as variaveis de sessao ao final da execucao",
              "['tokenAdmin', 'tokenCliente', 'bairroId', 'emailCliente', 'clienteId', 'tokenAdulterated'].forEach(function (k) {",
              "    pm.collectionVariables.set(k, '');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{tokenAdmin}}", "type": "string" }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/bairros/{{bairroId}}",
          "host": ["{{baseUrl}}"],
          "path": ["bairros", "{{bairroId}}"]
        }
      },
      "response": []
