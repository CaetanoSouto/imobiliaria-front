    {
      "name": "02 - POST /auth/login (Admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('02 - Status 200: login admin bem-sucedido', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.test('02 - tipo = ADMIN no retorno', function () {",
              "    pm.expect(json.tipo).to.eql('ADMIN');",
              "});",
              "if (json && json.token) {",
              "    pm.collectionVariables.set('tokenAdmin', json.token);",
              "    console.log('tokenAdmin salvo.');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@email.com\",\n  \"password\": \"123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      },
      "response": []
